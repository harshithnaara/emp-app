{"ast":null,"code":"export default {\n  props: ['initialData', 'isEditMode', 'saving'],\n  emits: ['submit', 'cancel'],\n  data() {\n    return {\n      form: {\n        name: '',\n        designation: '',\n        department: '',\n        salary: ''\n      }\n    };\n  },\n  watch: {\n    initialData: {\n      immediate: true,\n      handler(val) {\n        this.form = {\n          ...val\n        };\n      }\n    }\n  },\n  methods: {\n    saveEmployee() {\n      this.$emit('submit', this.form);\n    }\n  }\n};","map":{"version":3,"names":["props","emits","data","form","name","designation","department","salary","watch","initialData","immediate","handler","val","methods","saveEmployee","$emit"],"sources":["C:\\Users\\chind\\Downloads\\Vue_employee_using_mockapi-main\\emp-app\\src\\components\\EmployeeForm.vue"],"sourcesContent":["<template>\r\n  <div class=\"d-flex justify-content-center\">\r\n    <div class=\"card p-3\" style=\"width: 400px;\">\r\n\r\n\r\n  <h5 class=\"text-center mb-3\">Employee Details</h5>\r\n\r\n  <form @submit.prevent=\"saveEmployee\">\r\n\r\n    <input\r\n      v-model=\"form.name\"\r\n      placeholder=\"Name\"\r\n      class=\"form-control mb-2\"\r\n      required\r\n    />\r\n\r\n    <input\r\n      v-model=\"form.designation\"\r\n      placeholder=\"Designation\"\r\n      class=\"form-control mb-2\"\r\n      required\r\n    />\r\n\r\n    <input\r\n      v-model=\"form.department\"\r\n      placeholder=\"Department\"\r\n      class=\"form-control mb-2\"\r\n      required\r\n    />\r\n\r\n    <input\r\n      v-model=\"form.salary\"\r\n      type=\"number\"\r\n      placeholder=\"Salary\"\r\n      class=\"form-control mb-3\"\r\n      required\r\n    />\r\n\r\n    <button class=\"btn btn-primary w-100\">\r\n      {{ isEditMode ? 'Update' : 'Add' }}\r\n    </button>\r\n\r\n  </form>\r\n</div>\r\n\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  props: ['initialData', 'isEditMode', 'saving'],\r\n  emits: ['submit', 'cancel'],\r\n\r\n  data() {\r\n    return {\r\n      form: {\r\n        name: '',\r\n        designation: '',\r\n        department: '',\r\n        salary: ''\r\n      }\r\n    }\r\n  },\r\n\r\n  watch: {\r\n    initialData: {\r\n      immediate: true,\r\n      handler(val) {\r\n        this.form = { ...val }\r\n      }\r\n    }\r\n  },\r\n\r\n  methods: {\r\n    saveEmployee() {\r\n      this.$emit('submit', this.form)\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAkDA,eAAe;EACbA,KAAK,EAAE,CAAC,aAAa,EAAE,YAAY,EAAE,QAAQ,CAAC;EAC9CC,KAAK,EAAE,CAAC,QAAQ,EAAE,QAAQ,CAAC;EAE3BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,IAAI,EAAE,EAAE;QACRC,WAAW,EAAE,EAAE;QACfC,UAAU,EAAE,EAAE;QACdC,MAAM,EAAE;MACV;IACF;EACF,CAAC;EAEDC,KAAK,EAAE;IACLC,WAAW,EAAE;MACXC,SAAS,EAAE,IAAI;MACfC,OAAOA,CAACC,GAAG,EAAE;QACX,IAAI,CAACT,IAAG,GAAI;UAAE,GAAGS;QAAI;MACvB;IACF;EACF,CAAC;EAEDC,OAAO,EAAE;IACPC,YAAYA,CAAA,EAAG;MACb,IAAI,CAACC,KAAK,CAAC,QAAQ,EAAE,IAAI,CAACZ,IAAI;IAChC;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}