{"ast":null,"code":"export default {\n  props: ['employees'],\n  emits: ['delete']\n};","map":{"version":3,"names":["props","emits"],"sources":["C:\\Users\\chind\\Downloads\\Vue_employee_using_mockapi-main\\emp-app\\src\\components\\EmployeeList.vue"],"sourcesContent":["<template>\r\n  <table class=\"table table-bordered text-center\">\r\n    <thead class=\"table-dark\">\r\n      <tr>\r\n        <th>ID</th>\r\n        <th>Name</th>\r\n        <th>Designation</th>\r\n        <th>Department</th>\r\n        <th>Salary</th>\r\n        <th>Actions</th>\r\n      </tr>\r\n    </thead>\r\n\r\n<tbody>\r\n  <tr v-for=\"emp in employees\" :key=\"emp.id\">\r\n    <td>{{ emp.id }}</td>\r\n    <td>{{ emp.name }}</td>\r\n    <td>{{ emp.designation }}</td>\r\n    <td>{{ emp.department }}</td>\r\n    <td>{{ emp.salary }}</td>\r\n    <td>\r\n      <router-link :to=\"`/edit/${emp.id}`\" class=\"btn btn-warning btn-sm me-2\">\r\n        Edit\r\n      </router-link>\r\n\r\n      <button class=\"btn btn-danger btn-sm\" @click=\"$emit('delete', emp.id)\">\r\n        Delete\r\n      </button>\r\n    </td>\r\n  </tr>\r\n</tbody>\r\n\r\n  </table>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  props: ['employees'],\r\n  emits: ['delete']\r\n}\r\n</script>\r\n"],"mappings":"AAoCA,eAAe;EACbA,KAAK,EAAE,CAAC,WAAW,CAAC;EACpBC,KAAK,EAAE,CAAC,QAAQ;AAClB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}